PORT=3001
TURSO_URL=http://localhost:8080

# Matched keypair for sqld's JWT auth (docker compose only), generate with `node scripts/gen-db-auth-token.mjs`.
TURSO_AUTH_JWT_PUBLIC_KEY=
TURSO_AUTH_TOKEN=

# SMTP for verification/reset emails: EMAIL_ENABLED=false (or unset) just logs links to the
# console, regardless of whether SMTP_* below is filled in. Set EMAIL_ENABLED=true only once
# SMTP_HOST/SMTP_USER/SMTP_PASS are all real, since the API refuses to boot otherwise.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KingOfCards <no-reply@kingofcards.local>
WEB_BASE_URL=http://localhost:5173

# Error tracking: unset SENTRY_DSN just logs errors to stdout locally.
SENTRY_DSN=
