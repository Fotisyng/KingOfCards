PORT=3001
TURSO_URL=http://localhost:8080

# Matched keypair for sqld's JWT auth (docker compose only), generate with `node scripts/gen-db-auth-token.mjs`.
TURSO_AUTH_JWT_PUBLIC_KEY=
TURSO_AUTH_TOKEN=

# Email for verification/reset links: EMAIL_ENABLED=false (or unset) just logs links to the
# console, regardless of whether the transport vars below are filled in. Set EMAIL_ENABLED=true
# only once the active EMAIL_TRANSPORT's required vars are all real, since the API refuses to
# boot otherwise. EMAIL_TRANSPORT picks which one: "smtp" (default) uses SMTP_*; "resend_api"
# calls Resend's HTTPS REST API directly with RESEND_API_KEY, needed on Render's free tier since
# it blocks outbound SMTP ports entirely.
EMAIL_ENABLED=false
EMAIL_TRANSPORT=smtp
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KingOfCards <no-reply@kingofcards.local>
WEB_BASE_URL=http://localhost:5173

# Error tracking: unset SENTRY_DSN just logs errors to stdout locally.
SENTRY_DSN=
